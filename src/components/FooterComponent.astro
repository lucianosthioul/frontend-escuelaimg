---
// Importamos funciones para conectar con Strapi
import { fetchFromAPI, STRAPI_BASE_URL } from '../lib/conection'

// Obtenemos los datos del footer desde Strapi
const data = await fetchFromAPI('footer')
---

<footer class="FooterContenedor">

    <!-- Título principal del footer -->
    <h2 class="FooterTitulo">
        {data.titulo}
    </h2>

    <!-- Eslogan o texto secundario -->
    <p class="FooterEslogan">
        {data.eslogan}
    </p>

</footer>
