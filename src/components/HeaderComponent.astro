---

import logo from '../assets/images/logo.png'

interface Props {
    navStyle?: 'transparent' | 'solid';
}

const { navStyle = 'transparent' } = Astro.props;

// Definimos las clases exactas para que coincidan con las que usa el JS después
const solidClasses = "NavEstadoSolido";
const transparentClasses = "NavEstadoTransparente";

// Si navStyle es 'solid', usamos las clases sólidas. Si no, las transparentes.
const initialClasses = navStyle === 'solid' ? solidClasses : transparentClasses;
---

<nav
        id="navbar"
        data-style={navStyle}
        class={`NavContenedor ${initialClasses}`}
>

    <div class="NavLogoWrapper">
        <a href="/"><img src={logo.src} alt="Logo de la Escuela" class="h-15"></a>
    </div>

    <div class="NavMenuEscritorio">
        <a href="/nosotros" class="NavLinkEscritorio">NOSOTROS</a>
        <a href="/academico" class="NavLinkEscritorio">ACADÉMICO</a>
        <a href="/admisiones" class="NavLinkEscritorio">ADMISIONES</a>
        <a href="/noticias" class="NavLinkEscritorio">NOTICIAS</a>
    </div>

    <button id="menu-btn" class="NavBotonHamburguesa" aria-label="Abrir menú">

        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="NavIcono icon-hamburger">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>

        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="NavIcono icon-close hidden text-slate-900">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    <div
            id="mobile-menu"
            class="hidden absolute top-full left-0 w-full bg-white/90 backdrop-blur-md flex-col items-center gap-4 py-6 shadow-xl border-t border-gray-100 animate-fade-in"
    >
        <a href="/" class="NavLinkMovil">
            Inicio
        </a>
        <a href="/nosotros" class="NavLinkMovil">
            Nosotros
        </a>
        <a href="/academico" class="NavLinkMovil">
            Académico
        </a>
        <a href="/admisiones" class="NavLinkMovil">
            Admisiones
        </a>
        <a href="/noticias" class="NavLinkMovil">
            Noticias
        </a>
    </div>

</nav>

<script src="../assets/js/scroll.js"></script>