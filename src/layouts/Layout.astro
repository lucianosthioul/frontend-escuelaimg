---
import '../styles/global.css'
import HeaderComponent from '../components/HeaderComponent.astro'
import FooterComponent from '../components/FooterComponent.astro'

interface Props {
    title: string;
    // AGREGA ESTA LÍNEA (El ? significa que es opcional)
    navStyle?: 'transparent' | 'solid';
}

// Extraemos navStyle con un valor por defecto
const { title, navStyle = 'transparent' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
</head>
<body class="bg-stone-50 text-slate-900 antialiased">

<HeaderComponent navStyle={navStyle} />

<slot />
<FooterComponent />
</body>
</html>