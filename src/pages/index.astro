---
import {Image} from "astro:assets"
import { fetchFromAPI, STRAPI_BASE_URL } from "../lib/conection";
// Fetch de datos de la página de inicio desde Strapi
const data = await fetchFromAPI('home');
import Layout from '../layouts/Layout.astro';
---

<Layout title={data.title}>
    {/* Imagen de fondo a pantalla completa */}
    <section class="relative h-screen w-full sticky top-0 -z-10 flex items-center justify-center overflow-hidden">
        {/* Overlay oscuro para mejorar legibilidad del texto */}
        <div class="absolute inset-0 bg-black/30 z-10"></div>
        {/* Imagen de fondo usando el componente optimizado de Astro */}
        <Image src={`${STRAPI_BASE_URL}${data.imagen.url}` || ''} inferSize={true} alt="Escuela" class="absolute inset-0 w-full h-full object-cover"/>

        {/* Contenido centrado de la imagen */}
        <div class="pt-15 relative z-20 text-center text-white px-4 max-w-4xl mx-auto">
            {/* Subtítulo con animación */}
            <p class="text-sm md:text-base uppercase tracking-[0.3em] mb-4 animate-fade-in-up">
                {data.subtitle}
            </p>
            {/* Título principal */}
            <h1 class="text-5xl md:text-7xl lg:text-8xl italic font-serif leading-tight mb-8">
                {data.title}
            </h1>
            {/* Separador */}
            <div class="mt-12">
                <span class="block w-[1px] h-24 bg-white/50 mx-auto"></span>
            </div>
        </div>
    </section>

    {/* Sección de contenido con imagen y texto */}
    <section class="relative z-20 bg-[#f4f1ea] py-24 md:py-32 px-6">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            {/* Columna de imagen - orden cambia en responsive */}
            <div class="order-2 md:order-1">
                <Image src={`${STRAPI_BASE_URL}${data.imagen2.url}` || ''}
                       alt="Vida de estudiantes"
                       inferSize={true}
                       class="w-full h-[600px] object-cover rounded-sm shadow-xl"
                />
            </div>
            {/* Columna de texto - orden cambia en responsive */}
            <div class="order-1 md:order-2 space-y-8">
                <h2 class="text-4xl md:text-5xl text-slate-900 leading-tight">
                    {data.subtitle2}
                </h2>
                <p class="text-lg text-slate-600 leading-relaxed font-light">
                    {data.parrafo2}
                </p>
                {/* Enlace estilizado como botón de texto */}
                <a href="/nosotros" class="inline-block border-b border-slate-900 pb-1 text-sm uppercase tracking-widest hover:text-slate-600 transition">
                    {data.boton2}
                </a>
            </div>
        </div>
    </section>

    {/* Sección de tres pilares con efecto hover */}
    <section class="relative bg-slate-900 text-white py-32 px-6">
        <div class="max-w-7xl mx-auto">
            {/* Título de la sección */}
            <div class="text-center mb-20">
                <h3 class="text-3xl md:text-5xl font-serif italic">
                    {data.subtitle3}
                </h3>
            </div>

            {/* Grid de 3 columnas para los pilares */}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-1">

                {/* Primer pilar: Arte y Cultura */}
                <a href="/pilares/arte-cultura" class="group relative h-[500px] overflow-hidden cursor-pointer block">
                    <Image src={`${STRAPI_BASE_URL}${data.slider1.url}` || ''} inferSize={true}
                           alt=""
                           class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100"
                    />
                    {/* Overlay con gradiente y contenido que aparece al hacer hover */}
                    <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 to-transparent">
                        <h4 class="text-2xl font-serif italic">
                            {data.tituloslider1}
                        </h4>
                        {/* Descripción que se expande al hacer hover */}
                        <p class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 text-sm text-gray-300 transition-all duration-500">
                            {data.subtitleslider1}
                        </p>
                    </div>
                </a>

                {/* Segundo pilar: Ciencias - con desplazamiento negativo en md */}
                <a href="/pilares/ciencias" class="group relative h-[500px] overflow-hidden cursor-pointer block md:-mt-12">
                    <Image src={`${STRAPI_BASE_URL}${data.slider2.url}` || ''} inferSize={true}
                           alt=""
                           class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100"
                    />
                    <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 to-transparent">
                        <h4 class="text-2xl font-serif italic">
                            {data.tituloslider2}
                        </h4>
                        <p class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 text-sm text-gray-300 transition-all duration-500">
                            {data.subtitleslider2}
                        </p>
                    </div>
                </a>

                {/* Tercer pilar: Deportes */}
                <a href="/pilares/deportes" class="group relative h-[500px] overflow-hidden cursor-pointer block">
                    <Image src={`${STRAPI_BASE_URL}${data.slider3.url}` || ''} inferSize={true}
                           alt=""
                           class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100"
                    />
                    <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 to-transparent">
                        <h4 class="text-2xl font-serif italic">
                            {data.tituloslider3}
                        </h4>
                        <p class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 text-sm text-gray-300 transition-all duration-500">
                            {data.subtitleslider3}
                        </p>
                    </div>
                </a>

            </div>
        </div>
    </section>
</Layout>