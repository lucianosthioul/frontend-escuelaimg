---

import Layout from '../layouts/Layout.astro';

---

<Layout>
    <section class="relative h-screen w-full sticky top-0 -z-10 flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-black/30 z-10"></div>
        <img
                src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?q=80&w=2070&auto=format&fit=crop"
                alt="Campus"
                class="absolute inset-0 w-full h-full object-cover"
        />

        <div class="pt-15 relative z-20 text-center text-white px-4 max-w-4xl mx-auto">
            <p class="text-sm md:text-base uppercase tracking-[0.3em] mb-4 animate-fade-in-up">Bienvenidos a la excelencia</p>
            <h1 class="text-5xl md:text-7xl lg:text-8xl italic font-serif leading-tight mb-8">
                Cultivando el <br/><span class="not-italic">Carácter</span>
            </h1>
            <div class="mt-12">
                <span class="block w-[1px] h-24 bg-white/50 mx-auto"></span>
            </div>
        </div>
    </section>

    <section class="relative z-20 bg-[#f4f1ea] py-24 md:py-32 px-6">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <div class="order-2 md:order-1">
                <img
                        src="https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=2132&auto=format&fit=crop"
                        class="w-full h-[600px] object-cover rounded-sm shadow-xl"
                        alt="Student life"
                />
            </div>
            <div class="order-1 md:order-2 space-y-8">
                <h2 class="text-4xl md:text-5xl text-slate-900 leading-tight">
                    La educación no es solo <span class="italic text-slate-500">aprender</span>, es despertar.
                </h2>
                <p class="text-lg text-slate-600 leading-relaxed font-light">
                    En nuestro campus, rodeado de naturaleza inspiradora, formamos a los líderes del mañana a través de un currículo desafiante y una vida comunitaria vibrante.
                </p>
                <a href="#" class="inline-block border-b border-slate-900 pb-1 text-sm uppercase tracking-widest hover:text-slate-600 transition">
                    Descubre nuestra filosofía
                </a>
            </div>
        </div>
    </section>

    <section class="relative bg-slate-900 text-white py-32 px-6">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-20">
                <h3 class="text-3xl md:text-5xl font-serif italic">Nuestros Pilares</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
                <div class="group relative h-[500px] overflow-hidden cursor-pointer">
                    <img src="https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=2070&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100" />
                    <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 to-transparent">
                        <h4 class="text-2xl font-serif italic">Arte & Cultura</h4>
                        <p class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 text-sm text-gray-300 transition-all duration-500">Creatividad sin límites.</p>
                    </div>
                </div>
                <div class="group relative h-[500px] overflow-hidden cursor-pointer md:-mt-12"> <img src="https://images.unsplash.com/photo-1564981797816-1043664bf78d?q=80&w=1974&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100" />
                    <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 to-transparent">
                        <h4 class="text-2xl font-serif italic">Ciencias</h4>
                        <p class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 text-sm text-gray-300 transition-all duration-500">Innovación constante.</p>
                    </div>
                </div>
                <div class="group relative h-[500px] overflow-hidden cursor-pointer">
                    <img src="https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?q=80&w=2069&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100" />
                    <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 to-transparent">
                        <h4 class="text-2xl font-serif italic">Deportes</h4>
                        <p class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 text-sm text-gray-300 transition-all duration-500">Mente sana en cuerpo sano.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script src="../assets/js/scroll.js"></script>