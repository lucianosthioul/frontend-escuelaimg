---

import Layout from '../layouts/Layout.astro';

// Datos falsos (Simulando una base de datos)
const noticias = [
    {
        id: 'victoria-debate',
        titulo: 'Primer Lugar en el Torneo Nacional de Debate',
        fecha: '12 OCT 2023',
        categoria: 'Académico',
        imagen: "src/assets/images/debate.png",
        resumen: 'Nuestros estudiantes demostraron una retórica excepcional y pensamiento crítico ante más de 50 instituciones.'
    },
    {
        id: 'concierto-primavera',
        titulo: 'Melodías de Nuestra Infancia: Concierto Anual',
        fecha: '15 NOV 2024',
        categoria: 'Música',
        imagen: '/src/assets/images/musica.png',
        resumen: 'El auditorio se llenó de magia con las melodías interpretadas por el coro de 3° y 4° básico, acompañados por nuestra pequeña orquesta de iniciación.'
    },
    {
        id: 'festival-arte',
        titulo: '¡Nuestros Pequeños Artistas Conquistan el Festival Regional!',
        fecha: '20 ABR 2024',
        categoria: 'Arte y Cultura',
        imagen: '/src/assets/images/regional.png',
        resumen: 'Cinco estudiantes de nuestra escuela brillaron con sus creaciones en el "Festival Regional de Arte Escolar – ¡Pequeños Genios!", obteniendo reconocimientos en diversas categorías como pintura, escultura y dibujo. Sus obras mostraron talento, creatividad y mucho color, llenando de orgullo a toda la comunidad educativa.'
    },
    {
        id: 'dia-deporte',
        titulo: 'Día del Deporte: ¡Risas, Juegos y Mucha Energía en Nuestro Campo Escolar!',
        fecha: '05 MAY 2024',
        categoria: 'Deportes y Eventos',
        imagen: '/src/assets/images/deporte.png',
        resumen: 'Celebrar el deporte es celebrar la vida sana y la amistad. Nuestra escuela disfrutó de un inolvidable Día del Deporte con carreras de sacos, tirar de la cuerda, circuitos de obstáculos y partidos amistosos. Todos los niños y niñas participaron con entusiasmo, demostrando espíritu deportivo y trabajo en equipo.'
    }
];
---

<Layout title="Noticias & Actualidad" navStyle="solid">

    <div class="bg-slate-50 pt-32 pb-16 px-6 text-center">
        <p class="text-xs font-bold tracking-[0.2em] text-slate-500 uppercase mb-4">Nuestro Diario</p>
        <h1 class="text-5xl md:text-6xl font-serif text-slate-900 italic">Actualidad & <span class="not-italic">Eventos</span></h1>
    </div>

    <section class="max-w-7xl mx-auto px-6 pb-24">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">

            {noticias.map((noticia, index) => (
                // LÓGICA: Si es el index 0 (primera noticia), ocupa 2 columnas (md:col-span-2) para destacarla
        <article class={`group cursor-pointer flex flex-col ${index === 0 ? 'md:col-span-2 lg:col-span-2' : ''}`}>

                        <a href={`/noticias/${noticia.id}`} class="block overflow-hidden rounded-sm mb-6 relative aspect-[16/10]">
                            <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition z-10"></div>
                            <img
                                    src={noticia.imagen}
                                    alt={noticia.titulo}
                                    class="w-full h-full object-cover transform transition duration-700 group-hover:scale-105"
                            />
                            <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-slate-900 text-[10px] font-bold tracking-widest uppercase px-3 py-1 z-20">
                {noticia.categoria}
              </span>
                        </a>

                        <div class="space-y-3">
                            <div class="flex items-center gap-4 text-xs text-slate-400 font-medium tracking-widest uppercase">
                                <span>{noticia.fecha}</span>
                                <span class="w-8 h-[1px] bg-slate-300"></span>
                            </div>

                            <h2 class={`font-serif text-slate-900 group-hover:text-slate-600 transition duration-300 ${index === 0 ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl'}`}>
                                <a href={`/noticias/${noticia.id}`}>
                                    {noticia.titulo}
                                </a>
                            </h2>

                            <p class="text-slate-500 font-light leading-relaxed line-clamp-3">
                                {noticia.resumen}
                            </p>

                            <a href={`/noticias/${noticia.id}`} class="inline-block pt-2 text-xs font-bold uppercase tracking-widest border-b border-slate-300 pb-1 hover:border-slate-900 transition mt-2">
                                Leer Historia
                            </a>
                        </div>
                    </article>
            ))}

        </div>
    </section>
</Layout>

