---
import Layout from '../layouts/Layout.astro';

// Interface para tipar los datos de las noticias provenientes de Strapi
export interface NoticiasInterface {
    titulo: string;
    fecha: string;
    categoria: string;
    imagen: {
    url: string;
    };
    resumen: string;
    contenido: string;
    key: string; // Usado para construir la URL de la noticia detallada
    boton: string;
    }

// Importación de utilidades para conexión con la API de Strapi
import { fetchFromAPI, STRAPI_BASE_URL } from '../lib/conection';

// Se obtiene el array de noticias.
const noticias: NoticiasInterface[] = await fetchFromAPI('noticias');
---

<Layout title="Noticias & Actualidad" navStyle="solid">

    {/* Seccion Banner */}
    <div class="bg-slate-50 pt-32 pb-16 px-6 text-center">
        <p class="text-xs font-bold tracking-[0.2em] text-slate-500 uppercase mb-4">Nuestro Diario</p>
        <h1 class="text-5xl md:text-6xl font-serif text-slate-900 italic">Actualidad & <span class="not-italic">Eventos</span></h1>
    </div>

    {/* Grid de Noticias */}
    <section class="max-w-7xl mx-auto px-6 pb-24">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">

            {noticias.map((noticia, index) => (
                // El primer artículo (index 0) se destaca ocupando más columnas en breakpoints md y lg.
                <article class={`group cursor-pointer flex flex-col ${index === 0 ? 'md:col-span-2 lg:col-span-2' : ''}`}>

                    {/* Contenedor de la imagen con enlace a la noticia detallada */}
                        <a href={`/noticias/${noticia.key}`} class="block NuevasTarjetasImagen rounded-sm mb-6 aspect-[16/10]">
                            {/* Overlay semitransparente que desaparece al hacer hover */}
                            <div class="BannerOscuro bg-slate-900/10 group-hover:bg-transparent transition z-10"></div>
                            <img
                                    src={`${STRAPI_BASE_URL}${noticia.imagen.url}`}
                                    alt={noticia.titulo}
                                    class="w-full h-full object-cover transform transition duration-700 group-hover:scale-105"
                            />
                            {/* Icono de categoria superpuesto */}
                            <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-slate-900 text-[10px] font-bold tracking-widest uppercase px-3 py-1 z-20">
                            {noticia.categoria}
                        </span>
                        </a>

                    {/* Contenido textual de la tarjeta */}
                        <div class="space-y-3">
                            {/* Fecha y separador */}
                            <div class="BannerMeta">
                                <span>{noticia.fecha}</span>
                                <span class="w-8 h-[1px] bg-slate-300"></span>
                            </div>

                            {/* Título. Tamaño mayor para la noticia destacada (índice 0). */}
                            <h2 class={`font-serif text-slate-900 group-hover:text-slate-600 transition duration-300 ${index === 0 ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl'}`}>
                                <a href={`/noticias/${noticia.key}`}>
                                    {noticia.titulo}
                                </a>
                            </h2>

                            {/* Resumen de la noticia, recortado a 3 líneas con `line-clamp-3` */}
                            <p class="text-slate-500 font-light leading-relaxed line-clamp-3">
                                {noticia.resumen}
                            </p>

                            {/* Enlace "Leer más" con estilos personalizados */}
                            <a href={`/noticias/${noticia.key}`} class="LinkLeerMas">
                                Leer Historia
                            </a>
                        </div>
                    </article>
            ))}

        </div>
    </section>
</Layout>