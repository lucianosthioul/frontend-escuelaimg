---
import Layout from '../layouts/Layout.astro';
// Fetch de datos de la página de academico desde Strapi
import { fetchFromAPI, STRAPI_BASE_URL } from "../lib/conection";
const academico = await fetchFromAPI('academico');
const menuItems = academico?.items_parvularia || [];
const menuItems2 = academico?.items_basica || [];
---

<Layout navStyle="solid" title="Niveles Educativos">

    {/* Sección del Banner Principal */}
    <section class="h-[50vh] md:h-[60vh] min-h-[400px] md:min-h-[500px] w-full flex items-center justify-center NuevasTarjetasImagen text-center">

        <div class="BannerOscuro bg-slate-900/40 z-10"></div>

        <img
                src={`${STRAPI_BASE_URL}${academico.imagen.url}`}
                alt="Educación Parvularia y Básica"
                class="BannerOscuro w-full h-full object-cover object-center"
        />

        {/* Contenido del Banner */}
        <div class="BannerContenido px-6 max-w-4xl mx-auto flex flex-col items-center mt-12 md:mt-24">

            <p class="SubtituloSmall text-white/90 text-sm md:text-base">
                {academico.bajada_principal}
            </p>

            {/* Título: Reducimos el tamaño en móvil para evitar que se salga de la pantalla. */}
            <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-serif italic leading-tight text-white drop-shadow-md">
                {academico.titulo_principal}
            </h1>

        </div>

    </section>

    {/* Primera Sección de Contenido */}
    <section class="SectionContenido bg-stone-50 py-16 md:py-24 px-6">
        <h2 class="SectionTitulo text-slate-900 mb-10 md:mb-14 text-center text-3xl md:text-4xl">
            {academico.titulo_seccion_1}
        </h2>

        {/* Grid: Por defecto será 1 columna en móvil, y 3 en 'md:' o superior. */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 max-w-6xl mx-auto">

            {menuItems.map((item: any, index: any) => (
                    <div class="TarjetaFeature p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300">
                        {/* Ícono */}
                        <div class="ContenedorIconoTarjeta mb-4">{item.icono}</div>

                        {/* Título */}
                        <h3 class="text-xl font-serif text-slate-900 mb-2 italic">
                            {item.titulo}
                        </h3>

                        {/* Descripción */}
                        <p class="text-slate-600 font-light leading-relaxed text-sm">
                            {item.texto}
                        </p>
                    </div>
            ))}

        </div>
    </section>

    {/* Segunda Sección de Contenido */}
    <section class="bg-white border-t border-stone-200 py-16 md:py-24 px-6">
        <div class="max-w-7xl mx-auto">

            {/* Título de la Sección */}
            <h2 class="SectionTitulo text-slate-900 italic mb-10 md:mb-14 text-center text-3xl md:text-4xl">
                {academico.titulo_seccion_2}
            </h2>

            {/* Contenedor de las Tarjetas */}
            {/* Grid: Por defecto será 1 columna en móvil (sm:grid-cols-2 para más grandes), y 2 o 3 en 'md:' o 'lg:'. */}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
                {menuItems2.map((item: any, index: any) => (
                        <div class="TarjetaFeature p-6 bg-stone-50 rounded-lg shadow-sm">
                            {/* Título de la Tarjeta */}
                            <h3 class="text-xl font-serif text-slate-900 mb-3 italic">
                                {item.titulo}
                            </h3>

                            {/* Descripción */}
                            <p class="text-slate-600 font-light leading-relaxed text-sm">
                                {item.texto}
                            </p>
                        </div>
                ))}
            </div>
        </div>
    </section>

</Layout>