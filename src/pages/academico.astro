---

import Layout from '../layouts/Layout.astro';

---

<Layout navStyle="solid">

    <section class="bg-white pt-32 pb-20 px-6 text-center border-b border-black/10">
        <p class="text-xs font-bold tracking-[0.2em] text-black/50 uppercase mb-4">
            Nuestro Proyecto Educativo
        </p>

        <h1 class="text-5xl md:text-6xl font-serif text-black italic">
            Educación Parvularia & <span class="not-italic">Enseñanza Básica</span>
        </h1>
    </section>

    <!-- PARVULARIA -->
    <section class="max-w-7xl mx-auto px-6 py-24">
        <h2 class="text-3xl md:text-4xl font-serif text-black italic text-center mb-14">
            Educación Parvularia
        </h2>

        <div class="grid md:grid-cols-3 gap-10">

            <!-- Juego -->
            <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 text-center hover:shadow-md transition">
                <div class="w-20 h-20 bg-black/5 rounded-full mx-auto mb-6"></div>
                <h3 class="text-xl font-semibold text-black mb-2">Juego</h3>
                <p class="text-black/60 leading-relaxed">
                    El juego es el motor del aprendizaje temprano, permitiendo explorar, crear
                    y expresar emociones en un entorno seguro.
                </p>
            </div>

            <!-- Descubrimiento -->
            <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 text-center hover:shadow-md transition">
                <div class="w-20 h-20 bg-black/5 rounded-full mx-auto mb-6"></div>
                <h3 class="text-xl font-semibold text-black mb-2">Descubrimiento</h3>
                <p class="text-black/60 leading-relaxed">
                    Fomentamos la curiosidad mediante experiencias sensoriales y cognitivas que
                    impulsan el pensamiento creativo y la resolución de problemas.
                </p>
            </div>

            <!-- Socialización -->
            <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 text-center hover:shadow-md transition">
                <div class="w-20 h-20 bg-black/5 rounded-full mx-auto mb-6"></div>
                <h3 class="text-xl font-semibold text-black mb-2">Socialización</h3>
                <p class="text-black/60 leading-relaxed">
                    Desarrollamos habilidades socioemocionales fortaleciendo la convivencia,
                    el respeto, la empatía y el trabajo colaborativo.
                </p>
            </div>

        </div>
    </section>

    <!-- ENSEÑANZA BÁSICA -->
    <section class="bg-white border-t border-black/10 py-24 px-6">
        <div class="max-w-7xl mx-auto">

            <h2 class="text-3xl md:text-4xl font-serif text-black italic text-center mb-14">
                Enseñanza Básica (1° a 8° Básico)
            </h2>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">

                <!-- 1°–2° Básico -->
                <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 hover:shadow-md transition">
                    <h3 class="text-xl font-semibold text-black mb-3">1° y 2° Básico</h3>
                    <p class="text-black/60 leading-relaxed">
                        Se consolidan la lectura, escritura y el pensamiento matemático
                        mediante metodologías activas y lúdicas.
                    </p>
                </div>

                <!-- 3°–4° Básico -->
                <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 hover:shadow-md transition">
                    <h3 class="text-xl font-semibold text-black mb-3">3° y 4° Básico</h3>
                    <p class="text-black/60 leading-relaxed">
                        Se amplían habilidades lectoras, comprensión del entorno social y
                        pensamiento lógico, junto con expresión artística.
                    </p>
                </div>

                <!-- 5°–6° Básico -->
                <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 hover:shadow-md transition">
                    <h3 class="text-xl font-semibold text-black mb-3">5° y 6° Básico</h3>
                    <p class="text-black/60 leading-relaxed">
                        Profundizamos en ciencias, matemáticas, investigación, redacción
                        y habilidades tecnológicas.
                    </p>
                </div>

                <!-- 7°–8° Básico -->
                <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 hover:shadow-md transition">
                    <h3 class="text-xl font-semibold text-black mb-3">7° y 8° Básico</h3>
                    <p class="text-black/60 leading-relaxed">
                        Preparamos la transición a Educación Media fortaleciendo el
                        pensamiento crítico, la argumentación y el trabajo en equipo.
                    </p>
                </div>

                <!-- Talleres Formativos -->
                <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 hover:shadow-md transition">
                    <h3 class="text-xl font-semibold text-black mb-3">Talleres Formativos</h3>
                    <p class="text-black/60 leading-relaxed">
                        Música, artes visuales, deportes, ciencias, robótica y más
                        para potenciar los talentos personales.
                    </p>
                </div>

                <!-- Convivencia Escolar -->
                <div class="bg-white border border-black/10 rounded-2xl shadow-sm p-10 hover:shadow-md transition">
                    <h3 class="text-xl font-semibold text-black mb-3">Convivencia Escolar</h3>
                    <p class="text-black/60 leading-relaxed">
                        Desarrollamos liderazgo, mediación, respeto e inclusión mediante
                        proyectos de formación ciudadana.
                    </p>
                </div>

            </div>
        </div>
    </section>

</Layout>

<script src="../assets/js/academico.js"></script>