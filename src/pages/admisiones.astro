---

import Layout from '../layouts/Layout.astro';

---

<Layout navStyle="solid" title="Admisiones">


    <!-- FORMULARIO DE ADMISIÓN -->
    <section class="bg-white border-t border-black/10 py-24 px-6 pt-35">
        <div class="max-w-3xl mx-auto">

            <h2 class="SectionTitulo text-black mb-10 text-center">
                Formulario de Admisión
            </h2>

            <p class="text-black/60 text-center mb-12">
                Completa el siguiente formulario para iniciar el proceso de postulación.
            </p>

            <form id="admisionForm" class="FormContenedor">

                <!-- Nombre del Apoderado -->
                <div>
                    <label class="FormLabel">Nombre del Apoderado</label>
                    <input
                            type="text"
                            name="apoderado"
                            required
                            class="FormInput"
                    />
                </div>

                <!-- Nombre del Estudiante -->
                <div>
                    <label class="FormLabel">Nombre del Estudiante</label>
                    <input
                            type="text"
                            name="estudiante"
                            required
                            class="FormInput"
                    />
                </div>

                <!-- Nivel al que Postula -->
                <div>
                    <label class="FormLabel">Nivel al que Postula</label>
                    <select
                            name="nivel"
                            required
                            class="FormInput"
                    >
                        <option value="">Seleccionar…</option>
                        <option>Pre-Kínder</option>
                        <option>Kínder</option>
                        <option>1° Básico</option>
                        <option>2° Básico</option>
                        <option>3° Básico</option>
                        <option>4° Básico</option>
                        <option>5° Básico</option>
                        <option>6° Básico</option>
                        <option>7° Básico</option>
                        <option>8° Básico</option>
                    </select>
                </div>

                <!-- Email -->
                <div>
                    <label class="FormLabel">Correo Electrónico</label>
                    <input
                            type="email"
                            name="email"
                            required
                            class="FormInput"
                    />
                </div>

                <!-- Mensaje -->
                <div>
                    <label class="FormLabel">Mensaje o Información Adicional</label>
                    <textarea
                            name="mensaje"
                            rows="4"
                            class="FormInput"
                    ></textarea>
                </div>

                <!-- Botón -->
                <button
                        type="submit"
                        class="BtnPrimario"
                >
                    Enviar Postulación
                </button>

                <!-- Mensaje de éxito -->
                <p id="successMsg" class="text-green-600 text-center font-medium hidden">
                    ¡Tu postulación ha sido enviada con éxito!
                </p>
            </form>

        </div>
    </section>


    <!-- CONTACTO -->
<section class="bg-white border-t border-black/10 py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">

        <h2 class="SectionTitulo text-black mb-10">
            Contáctanos
        </h2>

        <p class="text-black/60 mb-12">
            Si tienes preguntas sobre admisiones, nuestro proyecto educativo o cualquier otro asunto,
            estaremos felices de ayudarte.
        </p>

        <form id="contactForm" class="FormContenedor text-left">

            <!-- Nombre -->
            <div>
                <label class="FormLabel">Nombre</label>
                <input
                        type="text"
                        name="nombre"
                        required
                        class="FormInput"
                />
            </div>

            <!-- Email -->
            <div>
                <label class="FormLabel">Correo Electrónico</label>
                <input
                        type="email"
                        name="email"
                        required
                        class="FormInput"
                />
            </div>

            <!-- Mensaje -->
            <div>
                <label class="FormLabel">Mensaje</label>
                <textarea
                        name="mensaje"
                        rows="5"
                        required
                        class="FormInput"
                ></textarea>
            </div>

            <!-- Botón -->
            <button
                    type="submit"
                    class="BtnPrimario"
            >
                Enviar Mensaje
            </button>

            <p id="contactMsg" class="text-green-600 text-center font-medium hidden">
                ¡Mensaje enviado correctamente!
            </p>

        </form>

    </div>
</section>

</Layout>

<script src="../assets/js/formulario.js"></script>
