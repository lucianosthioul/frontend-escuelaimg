---
// src/pages/pilares/[id].astro
import Layout from '../../layouts/Layout.astro';
import pilaresData from '../../assets/data/pilares.json';

// 1. Generar las rutas estáticas basadas en el JSON
export async function getStaticPaths() {
    return pilaresData.map((pilar) => ({
        params: { id: pilar.id },
        props: { pilar },
    }));
}

// 2. Obtener los datos para la página actual
const { pilar } = Astro.props;
---

<Layout title={`${pilar.titulo} - Colegio`} navStyle="solid">

    <header class="relative h-[70vh] min-h-[500px] w-full flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-slate-900/40 z-10"></div>
        <img
                src={pilar.Image}
                alt={pilar.titulo}
                class="absolute inset-0 w-full h-full object-cover attachment-fixed"
        />

        <div class="relative z-20 text-center text-white px-4 animate-fade-in-up">
      <span class="text-sm md:text-base font-bold tracking-[0.3em] uppercase mb-4 block opacity-90">
        Nuestros Pilares
      </span>
            <h1 class="text-5xl md:text-7xl font-serif italic mb-6">
                {pilar.titulo}
            </h1>
            <p class="text-lg md:text-xl font-light max-w-2xl mx-auto opacity-90">
                {pilar.bajada}
            </p>
        </div>
    </header>

    <section class="py-20 px-6 max-w-4xl mx-auto text-center">
        <div class="w-[1px] h-20 bg-slate-300 mx-auto mb-10"></div>
        <p class="text-xl md:text-2xl text-slate-700 font-serif leading-relaxed">
            {pilar.descripcion}
        </p>
    </section>

    <section class={`py-24 px-6 ${pilar.color}`}> <div class="max-w-6xl mx-auto space-y-24">

        {pilar.areas.map((area, index) => (
                <div class={`flex flex-col md:flex-row items-center gap-12 ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>

                    <div class="w-full md:w-1/2 relative group overflow-hidden shadow-2xl rounded-sm aspect-[4/3]">
                        <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/10 transition z-10"></div>
                        <img
                                src={area.img}
                                alt={area.nombre}
                                class="w-full h-full object-cover transition duration-700 transform group-hover:scale-110"
                        />
                    </div>

                    <div class="w-full md:w-1/2 text-center md:text-left space-y-4">
                        <h3 class="text-3xl font-serif text-slate-900 italic">
                            {area.nombre}
                        </h3>
                        <div class={`w-12 h-[2px] bg-slate-900 ${index % 2 === 1 ? 'md:ml-auto' : ''} mx-auto md:mx-0`}></div>
                        <p class="text-slate-600 leading-relaxed font-light text-lg">
                            {area.desc}
                        </p>
                    </div>

                </div>
        ))}

    </div>
    </section>

    <div class="bg-slate-900 text-white py-16 text-center">
        <p class="text-stone-400 text-sm uppercase tracking-widest mb-4">Sigue explorando</p>
        <a href="/" class="text-3xl font-serif italic hover:text-stone-300 transition inline-flex items-center gap-2">
            Volver al Inicio
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
        </a>
    </div>

</Layout>