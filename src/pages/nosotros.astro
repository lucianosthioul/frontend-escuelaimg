---
import Layout from '../layouts/Layout.astro';
// Importación de utilidades para conexión con la API de Strapi
import { fetchFromAPI, STRAPI_BASE_URL } from "../lib/conection";

// Fetch de datos de la página "Nosotros"
// La consulta incluye la imagen principal y el equipo con sus fotos.
const nosotros = await fetchFromAPI("nosotro?populate[imagen]=true&populate[equipo][populate][foto]=true");
---

<Layout title="Nuestra Historia y Equipo" navStyle="solid">

    {/* Banner con imagen de fondo y contenido superpuesto */}
    <header class="NuevasTarjetasImagen h-[50vh] md:h-[65vh] min-h-[400px] md:min-h-[450px] flex items-center justify-center pt-20 md:pt-32">
        {/* Overlay oscuro semitransparente para mejorar contraste del texto */}
        <div class="BannerOscuro bg-slate-900/40 z-10"></div>
        {/* Imagen de fondo del banner */}
        <img
                src={`${STRAPI_BASE_URL}${nosotros.imagen?.url}`}
                alt="Estudiantes en el campus"
                class="BannerOscuro w-full h-full object-cover"
        />
        {/* Contenido textual centrado sobre la imagen */}
        <div class="BannerContenido text-center text-white px-4 max-w-4xl mt-0 md:-mt-24">
            <p class="SubtituloSmall opacity-90">{nosotros.etiqueta}</p>
            <h1 class="text-4xl md:text-5xl lg:text-7xl font-serif italic mb-6">{nosotros.titulo}</h1>
            <p class="text-base md:text-xl font-light opacity-90 max-w-2xl mx-auto">
                {nosotros.descripcion}
            </p>
        </div>
    </header>

    {/* Sección de Misión y Visión */}
    <section class="py-12 md:py-24 px-6 bg-white">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 border-b border-stone-200 pb-16">
            {/* Columna de Misión */}
            <div class="p-4 text-center md:text-left">
                <h2 class="SectionTitulo mb-4 text-slate-900">{nosotros.mision_titulo}</h2>
                <div class="w-12 h-1 bg-slate-900 mb-6 mx-auto md:mx-0"></div>
                <p class="text-base md:text-lg text-slate-600 leading-relaxed">
                    {nosotros.mision_texto}
                </p>
            </div>
            {/* Columna de Visión */}
            <div class="p-4 text-center md:text-left">
                <h2 class="SectionTitulo mb-4 text-slate-900">{nosotros.vision_titulo}</h2>
                <div class="w-12 h-1 bg-slate-900 mb-6 mx-auto md:mx-0"></div>
                <p class="text-base md:text-lg text-slate-600 leading-relaxed">
                    {nosotros.vision_texto}
                </p>
            </div>
        </div>
    </section>

    {/* Sección del Equipo */}
    <section class="py-12 md:py-24 px-4 md:px-6 bg-stone-50">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-center SectionTitulo mb-10 md:mb-16 text-slate-900">{nosotros.equipo_titulo}</h2>

            {/* Grid responsivo para tarjetas de equipo */}
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8">
                {nosotros.equipo.map((miembro: any) => (
                    // Tarjeta individual con efectos de hover
                        <div class="group relative bg-white shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 rounded-sm">

                            {/* Imagen del miembro del equipo */}
                            <img
                                    src={`${STRAPI_BASE_URL}${miembro.foto.url}`}
                                    alt={miembro.nombre}
                                    class="w-full aspect-[3/4] h-auto object-cover object-top transition duration-500 group-hover:scale-105 grayscale group-hover:grayscale-0"
                            />

                            {/* Información visible: nombre y cargo */}
                            <div class="p-4 md:p-6 text-center">
                                <h4 class="text-sm md:text-xl font-serif text-slate-900 mb-1 leading-tight">{miembro.nombre}</h4>
                                <p class="text-[10px] md:text-sm text-stone-500 font-bold uppercase tracking-wider">{miembro.cargo}</p>
                            </div>

                            {/* Overlay con biografía que aparece al hacer hover */}
                            <div class="BannerOscuro bg-slate-900/90 flex items-center justify-center p-4 md:p-6 opacity-0 group-hover:opacity-100 transition duration-500">
                                <p class="text-white text-xs md:text-sm italic text-center leading-relaxed">
                                    {miembro.bio}
                                </p>
                            </div>

                        </div>
                ))}
            </div>
        </div>
    </section>

    {/* Sección final con frase inspiradora */}
    <section class="py-20 bg-slate-900 text-white text-center px-6">
        <h2 class="text-3xl md:text-5xl font-serif italic mb-8">{nosotros.frase_final}</h2>
    </section>

</Layout>